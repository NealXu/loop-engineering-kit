{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "source_role",
    "severity",
    "target",
    "claim",
    "evidence",
    "impact",
    "required_action",
    "criterion_ids",
    "status"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "kind": { "const": "finding" },
    "source_role": {
      "enum": ["producer", "verifier", "reviewer", "challenger", "arbiter"]
    },
    "severity": { "enum": ["low", "medium", "high", "blocking"] },
    "target": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "claim": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "impact": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "required_action": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "criterion_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
      }
    },
    "recurrence_of": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "prevention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "action", "evidence", "regression_verification_ids"],
      "properties": {
        "kind": {
          "enum": ["structure", "automatic_check", "skill_rule", "human_review"]
        },
        "action": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "regression_verification_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          }
        },
        "fallback_reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["automatic_check", "skill_rule", "human_review"]
              }
            },
            "required": ["kind"]
          },
          "then": { "required": ["fallback_reason"] }
        }
      ]
    },
    "status": {
      "enum": ["open", "resolved", "accepted_risk", "not_reproducible"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "severity": { "enum": ["high", "blocking"] }
        },
        "required": ["severity"]
      },
      "then": {
        "properties": {
          "status": {
            "enum": ["open", "resolved", "not_reproducible"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "severity": { "enum": ["high", "blocking"] },
          "status": { "enum": ["resolved", "not_reproducible"] }
        },
        "required": ["severity", "status"]
      },
      "then": { "required": ["prevention"] }
    },
    {
      "if": {
        "required": ["recurrence_of"]
      },
      "then": { "required": ["prevention"] }
    }
  ]
}
