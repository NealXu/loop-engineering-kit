{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "source_role",
    "severity",
    "target",
    "claim",
    "evidence",
    "impact",
    "required_action",
    "status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "kind": { "const": "finding" },
    "source_role": {
      "enum": ["producer", "verifier", "reviewer", "challenger", "arbiter"]
    },
    "severity": { "enum": ["low", "medium", "high", "blocking"] },
    "target": { "type": "string", "minLength": 1 },
    "claim": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "impact": { "type": "string", "minLength": 1 },
    "required_action": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["open", "resolved", "accepted_risk", "not_reproducible"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "severity": { "enum": ["high", "blocking"] }
        },
        "required": ["severity"]
      },
      "then": {
        "properties": {
          "status": {
            "enum": ["open", "resolved", "not_reproducible"]
          }
        }
      }
    }
  ]
}
