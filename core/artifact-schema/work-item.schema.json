{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-item.schema.json",
  "title": "Work Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "goal",
    "pack_id",
    "constraints",
    "priority",
    "risk_level",
    "max_repair_iterations",
    "acceptance_criteria"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "kind": { "const": "work_item" },
    "goal": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "pack_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "pattern": "\\S" }
    },
    "priority": { "enum": ["low", "medium", "high", "critical"] },
    "risk_level": { "enum": ["low", "medium", "high", "critical"] },
    "max_repair_iterations": { "type": "integer", "minimum": 0 },
    "acceptance_criteria": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "pattern": "\\S" }
    }
  }
}
