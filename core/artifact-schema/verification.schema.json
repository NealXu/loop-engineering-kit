{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification.schema.json",
  "title": "Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "artifact_id",
    "artifact_version",
    "artifact_content_hash",
    "criterion_ids",
    "check",
    "method",
    "status",
    "evidence",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "kind": { "const": "verification" },
    "role": {
      "enum": ["producer", "verifier", "reviewer", "challenger", "arbiter"]
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "artifact_version": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "artifact_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "criterion_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
      }
    },
    "finding_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "closure_gate": { "const": true },
    "host_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "model",
        "independence",
        "authentication"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "independence": {
          "enum": ["independent", "non_independent"]
        },
        "authentication": {
          "const": "unverified_host_attestation"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "executed_at"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "exit_code": { "type": "integer" },
        "executed_at": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "check": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "method": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    }
  },
  "allOf": [
    {
      "if": { "required": ["closure_gate"] },
      "then": {
        "required": ["role"],
        "properties": { "role": { "const": "verifier" } }
      }
    }
  ]
}
