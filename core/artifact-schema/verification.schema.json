{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification.schema.json",
  "title": "Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "artifact_id",
    "artifact_version",
    "criterion_ids",
    "check",
    "method",
    "status",
    "evidence",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "kind": { "const": "verification" },
    "role": {
      "enum": ["producer", "verifier", "reviewer", "challenger", "arbiter"]
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "artifact_version": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "criterion_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
      }
    },
    "finding_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "check": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "method": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    }
  }
}
