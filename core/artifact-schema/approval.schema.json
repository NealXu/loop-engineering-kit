{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "approval.schema.json",
  "title": "Human Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "work_item_id",
    "artifact_id",
    "artifact_version",
    "approver",
    "statement",
    "approved_at",
    "confirmation"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "kind": { "const": "approval" },
    "work_item_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "artifact_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "approver": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "approved_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "confirmation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
