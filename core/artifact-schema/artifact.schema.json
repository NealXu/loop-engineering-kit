{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact.schema.json",
  "title": "Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "artifact_type",
    "version",
    "content",
    "source",
    "files",
    "work_item_id"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "kind": { "const": "artifact" },
    "artifact_type": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "version": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "content": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "source": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "work_item_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    }
  }
}
