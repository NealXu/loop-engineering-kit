{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iteration.schema.json",
  "title": "Iteration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "work_item_id",
    "cycle",
    "input_versions",
    "changes",
    "result"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "kind": { "const": "iteration" },
    "work_item_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "cycle": { "type": "integer", "minimum": 1 },
    "input_versions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "output_versions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "changes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "result": {
      "enum": ["CONTINUE", "ACCEPT", "REPAIR", "ESCALATE", "STOP"]
    }
  }
}
