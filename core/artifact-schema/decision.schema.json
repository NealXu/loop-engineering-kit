{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision.schema.json",
  "title": "Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "work_item_id",
    "artifact_versions",
    "decision",
    "rationale",
    "evidence_refs",
    "unresolved_disagreements",
    "approver"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "kind": { "const": "decision" },
    "work_item_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "artifact_versions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "decision": { "enum": ["ACCEPT", "REPAIR", "ESCALATE", "STOP"] },
    "rationale": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "unresolved_disagreements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "approver": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "next_state": {
      "enum": ["PRODUCE", "VERIFY", "REVIEW", "CHALLENGE"]
    },
    "repair_kind": {
      "enum": ["artifact", "evidence"]
    },
    "criteria_evidence": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verification_ids", "result"],
        "properties": {
          "verification_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
            }
          },
          "result": { "const": "PASS" }
        }
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk", "owner"],
        "properties": {
          "risk": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "owner": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "finding_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
            }
        }
      }
    },
    "review_independence": {
      "enum": ["independent", "non_independent", "mixed", "not_required"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision": { "const": "ACCEPT" } },
        "required": ["decision"]
      },
      "then": {
        "required": [
          "criteria_evidence",
          "residual_risks",
          "review_independence"
        ],
        "properties": {
          "unresolved_disagreements": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": { "decision": { "const": "REPAIR" } },
        "required": ["decision"]
      },
      "then": {
        "required": ["next_state", "repair_kind"],
        "allOf": [
          {
            "if": {
              "properties": { "repair_kind": { "const": "artifact" } },
              "required": ["repair_kind"]
            },
            "then": {
              "properties": { "next_state": { "const": "PRODUCE" } }
            }
          },
          {
            "if": {
              "properties": { "repair_kind": { "const": "evidence" } },
              "required": ["repair_kind"]
            },
            "then": {
              "properties": { "next_state": { "const": "VERIFY" } }
            }
          }
        ]
      }
    }
  ]
}
